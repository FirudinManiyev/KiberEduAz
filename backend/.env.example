# ---------------------------------------------------------------------------
# Supabase project: postgre (ref okyhjpywngmportlzmxo, region ap-southeast-2)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://okyhjpywngmportlzmxo.supabase.co
SUPABASE_PROJECT_REF=okyhjpywngmportlzmxo

# Publishable key. Safe to expose; the frontend uses the same value.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_lWYnUvcI8qPwKEKJ3waBoQ_wLv7QaUu

# Secret key, used only for admin operations such as assigning roles.
# Dashboard -> Project Settings -> API Keys. NEVER commit the real value.
SUPABASE_SECRET_KEY=

# Fallback for projects still on the legacy HS256 JWT secret. Leave empty when
# the project uses asymmetric signing keys; the API discovers those via JWKS.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Database. Copy both strings from Dashboard -> Connect and fill in the password.
# DATABASE_URL goes through the pooler (port 6543) and is what the app uses.
# DIRECT_URL is the direct connection (port 5432) that migrations need.
# Percent-encode the password: characters such as @ # / : ? & are reserved in a
# connection URL, so a password like "pa@@ss" must be written "pa%40%40ss"
# (@ -> %40, # -> %23, / -> %2F, : -> %3A, ? -> %3F, & -> %26). Otherwise Prisma
# splits the string at the wrong character and the connection fails.
# ---------------------------------------------------------------------------
# The pooler hostname is per-tenant: this project lives on aws-1, and aws-0
# answers with "tenant/user not found". Always copy the host from the Dashboard.
# connection_limit=1 is only right for serverless. This API is a long-lived
# process that serves several queries per page, so a limit of 1 makes concurrent
# requests fail with Prisma P2024 (pool timeout).
DATABASE_URL=postgresql://postgres.okyhjpywngmportlzmxo:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
DIRECT_URL=postgresql://postgres.okyhjpywngmportlzmxo:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
# Render injects PORT itself; this value is only for local development.
PORT=4000
# Comma-separated allow list. An entry starting with * matches by hostname
# suffix. Vercel preview domains end with the team slug, so in production:
# CORS_ORIGINS=https://kiberedu.vercel.app,*-<team-slug>.vercel.app
CORS_ORIGINS=http://localhost:3000
