# Supabase project: kiberedu (ref okyhjpywngmportlzmxo)
NEXT_PUBLIC_SUPABASE_URL=https://okyhjpywngmportlzmxo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_lWYnUvcI8qPwKEKJ3waBoQ_wLv7QaUu

# NestJS API in backend/. In production this is the Render URL, e.g.
# https://kiberedu-api.onrender.com/api/v1
# Use 127.0.0.1 locally, not localhost: Node resolves localhost to ::1 first and
# the API listens on 0.0.0.0 (IPv4 only), so server-side fetches get ECONNREFUSED.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api/v1

# Public origin of this deployment, e.g. https://kiber-edu-az-one.vercel.app
# (no trailing slash, scheme required).
#
# Every Supabase auth mail (confirmation, password reset, email change) builds
# its redirect from this, and /auth/callback pins its redirect origin to it
# instead of trusting x-forwarded-host.
#
# On Vercel this is optional: if it is unset the app falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which the platform sets itself. Set it
# explicitly once the project has a custom domain, because the Vercel variable
# keeps pointing at the *.vercel.app one. Off Vercel it is required in
# production - the app throws rather than guessing. Empty locally means
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
